# 统一换行符，避免 Windows / macOS 协作时产生整文件 diff
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则 cmd 解析跳转标签会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
*.docx binary
*.xlsx binary

# 语言统计纠正
package-lock.json linguist-generated=true
